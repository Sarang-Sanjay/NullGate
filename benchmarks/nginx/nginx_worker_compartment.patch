+void *ngx_nullgate_secret_vault = NULL;
+void *ngx_nullgate_worker_stack = NULL;
+int   ngx_nullgate_enabled = 0;
+
+void ngx_nullgate_init_worker(void)
+{
+    if (ng_init() != NG_SUCCESS) {
+        fprintf(stderr, "[NULLGATE] Worker ng_init() failed\n");
+        return;
+    }
+
+    /* Allocate 64KB isolated stack for Domain 1 (HTTP Request Parsing) */
+    ngx_nullgate_worker_stack = mmap(NULL, 64 * 1024, PROT_READ | PROT_WRITE,
+                                     MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (ngx_nullgate_worker_stack == MAP_FAILED) {
+        perror("[NULLGATE] mmap worker stack failed");
+        return;
+    }
+
+    if (ng_domain_create(1, ngx_nullgate_worker_stack, 64 * 1024) != NG_SUCCESS) {
+        fprintf(stderr, "[NULLGATE] ng_domain_create(1) failed\n");
+        return;
+    }
+
+    /* Allocate 4KB secret vault isolated under PKU Key 2 */
+    ngx_nullgate_secret_vault = mmap(NULL, 4096, PROT_READ | PROT_WRITE,
+                                     MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (ngx_nullgate_secret_vault == MAP_FAILED) {
+        perror("[NULLGATE] mmap secret vault failed");
+        return;
+    }
+
+    if (ng_domain_create(2, ngx_nullgate_worker_stack, 64 * 1024) != NG_SUCCESS) {
+        fprintf(stderr, "[NULLGATE] ng_domain_create(2) failed\n");
+        return;
+    }
+
+    /* Populate vault with sensitive TLS session ticket key material */
+    memcpy(ngx_nullgate_secret_vault,
+           "NULLGATE_SESSION_TICKET_KEY_2026_TOP_SECRET_VAULT_BYTES", 56);
+
+    /* Protect secret vault exclusively under Key 2 */
+    if (ng_domain_protect(2, ngx_nullgate_secret_vault, 4096, PROT_READ | PROT_WRITE) != NG_SUCCESS) {
+        fprintf(stderr, "[NULLGATE] ng_domain_protect(2) failed\n");
+        return;
+    }
+
+    ngx_nullgate_enabled = 1;
+    printf("[NULLGATE] Worker compartmentalization initialized: Vault protected under Key 2\n");
+}
+#endif
 
